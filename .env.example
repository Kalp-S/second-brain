# ==============================================================================
# Second Brain PKM — Environment Configuration
# ==============================================================================

# LLM Provider Configuration ("ollama", "openai", "gemini", "groq", "mock")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b-instruct

# Cloud Provider API Keys (Optional fallbacks)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Models (Local ONNX CPU/GPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# RAG Hyperparameters
DENSE_TOP_K=15
BM25_TOP_K=15
RRF_K=60
RERANK_TOP_K=5
